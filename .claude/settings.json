{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-memory.sh\" --remote-only",
            "statusMessage": "load cross-session memory"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/wiki-reminder.sh\"",
            "statusMessage": "wiki reminder check"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/wiki-date.sh\"",
            "statusMessage": "wiki date bump"
          }
        ]
      }
    ]
  }
}
