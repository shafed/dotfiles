{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Agent",
      "Bash(pacman -Q wl-clipboard xdg-desktop-portal-hyprland)",
      "Bash(grim --version)",
      "Bash(wl-copy)",
      "Bash(wl-paste)",
      "Bash(echo \"---exit: $?\")",
      "Bash(timeout 10 telegram-desktop)",
      "Bash(ip addr *)",
      "Bash(gh repo *)",
      "Bash(pacman -Qs vim)",
      "Bash(pacman -Qs nvim)",
      "Bash(xdg-mime query *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/format.sh\"",
            "timeout": 60,
            "statusMessage": "format like conform in nvim"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/session-memory.sh\"",
            "statusMessage": "load cross-session memory"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/no-coauthor.sh\"",
            "statusMessage": "attribution footer guard"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "skill-creator@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "exa@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "voltagent-subagents": {
      "source": {
        "source": "github",
        "repo": "VoltAgent/awesome-claude-code-subagents"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "Russian",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:gruvbox-material",
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "useAutoModeDuringPlan": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC — shafed/dotfiles (github.com:shafed/dotfiles.git)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default); no branch protection rules or rulesets listed via gh — treat main as unprotected",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (shafed/dotfiles) and its origin remote (github.com:shafed/dotfiles.git) only",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: personal dotfiles management (public repo, single-user)",
      "**Trusted repo**: /home/shafed/dotfiles and its origin remote (github.com:shafed/dotfiles.git) — PUBLIC repo, so only this repo's own work belongs in commits/pushes here; confidential material, secrets, and sensitive data (personal & entrusted) are never cleared into it by visibility alone",
      "**Org-specific CLIs**: None configured",
      "No routine-under-<user>/-prefix qualifiers found"
    ]
  },
  "voiceEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
