#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"
DOTS_ROOT="$ROOT"
# shellcheck source=scripts/dots-lib.sh
source "$ROOT/scripts/dots-lib.sh"

usage() {
  cat <<'USAGE'
Usage: dots <command> [args]

Commands:
USAGE
  dots_print_commands
}

command_name="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command_name" in
  apply) exec "$ROOT/scripts/dots-apply.sh" "$@" ;;
  doctor) exec "$ROOT/scripts/dots-doctor.sh" "$@" ;;
  check) exec "$ROOT/scripts/dots-check.sh" "$@" ;;
  migrate) exec "$ROOT/scripts/dots-migrate.sh" "$@" ;;
  theme) exec "$ROOT/scripts/dots-theme.sh" "$@" ;;
  restart) exec "$ROOT/scripts/dots-restart.sh" "$@" ;;
  refresh) exec "$ROOT/scripts/dots-refresh.sh" "$@" ;;
  shell) exec "$ROOT/scripts/dots-shell.sh" shell "$@" ;;
  panel) exec "$ROOT/scripts/dots-shell.sh" panel "$@" ;;
  debug) exec "$ROOT/scripts/dots-debug.sh" "$@" ;;
  commands) exec "$ROOT/scripts/dots-commands.sh" "$@" ;;
  help|-h|--help)
    if [ "$#" -gt 0 ]; then
      exec "$SELF" "$1" --help
    fi
    usage
    ;;
  *)
    printf 'dots: unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
