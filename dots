#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"

usage() {
  cat <<'USAGE'
Usage: dots <command> [args]

Commands:
  doctor    Check the installed dotfiles state
  check     Run repository syntax checks and tests
  migrate   Apply safe dotfiles migrations
  theme     Show or switch the darkman theme
  help      Show this help
USAGE
}

command_name="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command_name" in
  doctor) exec "$ROOT/scripts/dots-doctor.sh" "$@" ;;
  check) exec "$ROOT/scripts/dots-check.sh" "$@" ;;
  migrate) exec "$ROOT/scripts/dots-migrate.sh" "$@" ;;
  theme) exec "$ROOT/scripts/dots-theme.sh" "$@" ;;
  help|-h|--help) usage ;;
  *)
    printf 'dots: unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
