#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"
DOTS_ROOT="$ROOT"
# shellcheck source=scripts/dots-lib.sh
source "$ROOT/scripts/dots-lib.sh"

usage() {
  cat <<'USAGE'
Usage: dots <command> [args]

Commands:
USAGE
  dots_print_commands
}

command_name="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command_name" in
plan | pl) exec "$ROOT/scripts/dots-plan.sh" "$@" ;;
apply | a) exec "$ROOT/scripts/dots-apply.sh" "$@" ;;
doctor | d) exec "$ROOT/scripts/dots-doctor.sh" "$@" ;;
check | c) exec "$ROOT/scripts/dots-check.sh" "$@" ;;
migrate | m) exec "$ROOT/scripts/dots-migrate.sh" "$@" ;;
history | hist) exec "$ROOT/scripts/dots-history.sh" "$@" ;;
show) exec "$ROOT/scripts/dots-show.sh" "$@" ;;
theme | t) exec "$ROOT/scripts/dots-theme.sh" "$@" ;;
restart | rs) exec "$ROOT/scripts/dots-restart.sh" "$@" ;;
refresh | rf) exec "$ROOT/scripts/dots-refresh.sh" "$@" ;;
shell | s) exec "$ROOT/scripts/dots-shell.sh" shell "$@" ;;
panel | p) exec "$ROOT/scripts/dots-shell.sh" panel "$@" ;;
debug | db) exec "$ROOT/scripts/dots-debug.sh" "$@" ;;
commands | ls) exec "$ROOT/scripts/dots-commands.sh" "$@" ;;
help | h | -h | --help)
  if [ "$#" -gt 0 ]; then
    case "$1" in
    help | h | -h | --help)
      usage
      exit 0
      ;;
    pl) command_name="plan" ;;
    a) command_name="apply" ;;
    d) command_name="doctor" ;;
    c) command_name="check" ;;
    m) command_name="migrate" ;;
    hist) command_name="history" ;;
    t) command_name="theme" ;;
    rs) command_name="restart" ;;
    rf) command_name="refresh" ;;
    s) command_name="shell" ;;
    p) command_name="panel" ;;
    db) command_name="debug" ;;
    ls) command_name="commands" ;;
    *) command_name="$1" ;;
    esac
    exec "$SELF" "$command_name" --help
  fi
  usage
  ;;
*)
  printf 'dots: unknown command: %s\n\n' "$command_name" >&2
  usage >&2
  exit 2
  ;;
esac
