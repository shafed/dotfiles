#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"
DOTS_ROOT="$ROOT"
# shellcheck source=scripts/dots-lib.sh
source "$ROOT/scripts/dots-lib.sh"

usage() {
  cat <<'USAGE'
Usage: dots <command> [args]

Commands:
USAGE
  dots_print_commands
}

raw_command="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

if ! command_name="$(dots_resolve_command "$raw_command")"; then
  printf 'dots: unknown command: %s\n\n' "$raw_command" >&2
  usage >&2
  exit 2
fi

case "$command_name" in
plan) exec bash "$ROOT/scripts/dots-plan.sh" "$@" ;;
apply) exec bash "$ROOT/scripts/dots-apply.sh" "$@" ;;
drift) exec bash "$ROOT/scripts/dots-drift.sh" "$@" ;;
provision) exec bash "$ROOT/scripts/dots-provision.sh" "$@" ;;
doctor) exec bash "$ROOT/scripts/dots-doctor.sh" "$@" ;;
check) exec bash "$ROOT/scripts/dots-check.sh" "$@" ;;
migrate) exec bash "$ROOT/scripts/dots-migrate.sh" "$@" ;;
history) exec bash "$ROOT/scripts/dots-history.sh" "$@" ;;
show) exec bash "$ROOT/scripts/dots-show.sh" "$@" ;;
rollback) exec bash "$ROOT/scripts/dots-rollback.sh" "$@" ;;
theme) exec bash "$ROOT/scripts/dots-theme.sh" "$@" ;;
restart) exec bash "$ROOT/scripts/dots-restart.sh" "$@" ;;
refresh) exec bash "$ROOT/scripts/dots-refresh.sh" "$@" ;;
shell) exec bash "$ROOT/scripts/dots-shell.sh" shell "$@" ;;
panel) exec bash "$ROOT/scripts/dots-shell.sh" panel "$@" ;;
debug) exec bash "$ROOT/scripts/dots-debug.sh" "$@" ;;
commands) exec bash "$ROOT/scripts/dots-commands.sh" "$@" ;;
aliases) exec bash "$ROOT/scripts/dots-aliases.sh" "$@" ;;
completion) exec bash "$ROOT/scripts/dots-completion.sh" "$@" ;;
help)
  if [ "$#" -gt 0 ]; then
    if ! help_command="$(dots_resolve_command "$1")"; then
      printf 'dots: unknown command: %s\n\n' "$1" >&2
      usage >&2
      exit 2
    fi
    if [ "$help_command" = "help" ]; then
      usage
      exit 0
    fi
    exec "$SELF" "$help_command" --help
  fi
  usage
  ;;
esac
