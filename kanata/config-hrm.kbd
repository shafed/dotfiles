;; Home-row mods, with layer entry on non-letter keys.
;; Space is an ordinary key: no tap-hold, chord or layer action.
;; See KEYMAP-hrm.md for the routes that changed and the complete layer map.

(defcfg
  process-unmapped-keys (all-except lctl ralt)
  danger-enable-cmd yes
  concurrent-tap-hold yes
  chords-v2-min-idle 80
)

(defhands
  (left  grv tab q w e r t caps a s d f g z x c v b esc)
  (right - = bspc y u i o p [ ] \ h j k l ; ' n m , . /)
)

(defvar
  tap-time 200
  layer-time 200
  hrm-time 400
  shift-time 300
  mode-time 600
  chord-time 35
  reset-chord-time 60
  aterm-settle 250
  ;; Global chord key sets must be unique. Only df/jk have two meanings.
  not-apps (base normal browser symbols symbols-left numws movews numplain numplain2 navi)
  not-base (apps normal browser symbols symbols-left numws movews numplain numplain2 navi)
  not-base-or-apps (normal browser symbols symbols-left numws movews numplain numplain2 navi)
)

;; Keep the existing opposite-hand HRM policy and timings.
(deftemplate hrm (timeout keytap keyhold)
  (tap-hold-opposite-hand-release $timeout $keytap $keyhold
    (neutral-keys 1 2 3 4 5 6 7 8 9 0 spc tab ret bspc esc)
    (neutral hold)
    (timeout hold)
  )
)

;; Layer keys are deliberately not letters. Retain timed holds so a quick
;; Alt tap does not become a layer just because another key overlaps it.
(deftemplate layer-key (keytap keyhold)
  (tap-hold $tap-time $layer-time $keytap $keyhold)
)

;; Focus kitty, wait for focus to settle, then send its session shortcut.
(deftemplate kitty-send (key)
  (multi (on-press tap-vkey apps-us) (macro @aterm $aterm-settle $key))
)

(defalias
  aterm (cmd zsh -lc "$HOME/.config/kanata/switchApp.sh kitty kitty")
  sshot-region (cmd zsh -lc "$HOME/.config/kanata/screenshot-region.sh")
  sshot-full (cmd zsh -lc "$HOME/.config/kanata/screenshot-full.sh")
  sw (cmd hyprctl switchxkblayout kanata next)
  ;; Each symbol layer owns enter/leave. Neither can enter the other:
  ;; use-defsrc fallback prevents nested US-layout wrappers.
  sym-enter (multi (on-press tap-vkey sym-us) (on-release tap-vkey sym-restore) (layer-while-held symbols))
  sym-left-enter (multi (on-press tap-vkey sym-us) (on-release tap-vkey sym-restore) (layer-while-held symbols-left))
  apps-enter (layer-while-held apps)
  base-mode (multi (layer-switch base) (cmd notify-send -t 1000 "⌨ base layer"))
  normal-mode (multi (layer-switch normal) (cmd notify-send -t 1000 "⌨ normal layer"))
  last-session (macro @aterm 100 A-tab)
  last-window (cmd hyprctl dispatch "hl.dsp.window.cycle_next()")
  last-workspace (cmd hyprctl dispatch r#"hl.dsp.focus({ workspace = "previous" })"#)
)

(defvirtualkeys
  sym-us (cmd /home/shafed/github/dotfiles/scripts/symlayout-watch.sh enter)
  sym-restore (cmd /home/shafed/github/dotfiles/scripts/symlayout-watch.sh leave)
  apps-us (cmd /home/shafed/github/dotfiles/scripts/symlayout-watch.sh app)
)

(defsrc)

(deflayermap (base)
  ;; AGCS, pinky to index, mirrored. These are the only letter tap-holds.
  a (t! hrm $hrm-time a lalt)
  s (t! hrm $hrm-time s lmet)
  d (t! hrm $hrm-time d lctl)
  f (t! hrm $shift-time f lsft)
  j (t! hrm $shift-time j rsft)
  k (t! hrm $hrm-time k rctl)
  l (t! hrm $hrm-time l rmet)
  ; (t! hrm $hrm-time ; ralt)

  caps (t! layer-key esc (layer-while-held navi))
  tab  (t! layer-key tab @sym-enter)
  lalt (t! layer-key bspc @apps-enter)
  ralt (t! layer-key @sw (layer-while-held numplain))

  ;; Keep Ctrl+W as Backspace, but W itself no longer has a hold action.
  w (fork w bspc (lctl rctl))
  ;; Physical Backspace and Enter work normally; hold Enter for plain mode.
  ret (tap-hold $tap-time $mode-time ret @normal-mode)
)

;; Caps held: right-hand navigation; the thumbs provide Ctrl and Shift.
;; Explicit source fallback prevents base HRMs/letter actions leaking in.
(deflayermap (navi)
  ___ use-defsrc
  h lft j down k up l right
  n C-lft m C-right
  y home ; end
  [ home ] end
  u C-S-tab i C-tab
  o A-lft p A-right
  ' del
  / tab
  bspc bspc
  ret ret
  tab tab
  lalt lctl ralt lsft
)

;; Tab held by the left hand: common symbols on the right, unchanged.
(deflayermap (symbols)
  ___ use-defsrc
  y grv u [   i ]   o S-=   p XX
  h -   j S-9 k S-0 l S-2   ; S-; ' S-'
  n S-- m =   , S-, . S-.   / S-/
)

;; Right Alt + H held by the right hand: the other symbols on the left.
;; Only H owns the US-layout wrapper; it restores the layout when released,
;; even if Right Alt is released first.
(deflayermap (symbols-left)
  ___ use-defsrc
  q S-grv w S-[ e S-] r S-7 t \
  a S-1 s S-3 d S-8 f S-\ g S-5
  z S-6 x S-4 c ; v ' b /
)

;; Right Alt held: left-hand digits and editing, right-hand selectors.
;; H: other symbols; J: shifted digits; K: workspaces; L: move window.
(deflayermap (numplain)
  ___ use-defsrc
  q 6 w 7 e 8 r 9 t 0
  a 1 s 2 d 3 f 4 g 5
  z @last-workspace x @last-window c C-c v C-v b @last-session
  y @sshot-full u @sshot-region
  i S-= o = m - n S--
  h @sym-left-enter
  j (layer-while-held numplain2)
  k (layer-while-held numws)
  l (layer-while-held movews)
)

(deflayermap (numplain2)
  ___ use-defsrc
  q S-6 w S-7 e S-8 r S-9 t S-0
  a S-1 s S-2 d S-3 f S-4 g S-5
)

(deflayermap (numws)
  ___ use-defsrc
  q M-6 w M-7 e M-8 r M-9 t M-0
  a M-1 s M-2 d M-3 f M-4 g M-5
)

(deflayermap (movews)
  ___ use-defsrc
  q M-S-6 w M-S-7 e M-S-8 r M-S-9 t M-S-0
  a M-S-1 s M-S-2 d M-S-3 f M-S-4 g M-S-5
)

(deflayermap (apps)
  ___ use-defsrc
  e (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell projects")) ;; project/session picker in Quickshell
  l (layer-while-held numws)  ;; hold: switch workspace (Super+digit)
  q (cmd zsh -lc "$HOME/github/dotfiles/kanata/close-window.sh") ;; graceful close -> apps with tray icons minimize instead of quitting; telegram is force-killed to actually quit
  t (t! kitty-send C-S-2)   ;; todos session
  r (t! kitty-send C-S-1)   ;; daily note
  y (cmd helium-browser --new-window https://www.youtube.com/playlist?list=WL)
  u (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell youtube")) ;; YouTube picker in Quickshell
  b (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell bookmarks")) ;; bookmarks Quickshell + fzf
  a (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell launcher")) ;; applications Quickshell launcher
  o (t! kitty-send C-S-o)   ;; obsidian session
  w (t! kitty-send C-S-w)   ;; downloads session
  h (t! kitty-send C-S-a)   ;; home session
  s (tap-hold-press $tap-time $layer-time (cmd helium-browser) (layer-while-held browser))
  d (t! kitty-send C-S-d)   ;; dotfiles session
  z (cmd zsh -lc "$HOME/.config/kanata/switchApp.sh sioyek '$HOME/.local/bin/sioyek' true")
  c (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell sessions")) ;; open kitty sessions in Quickshell
  g (t! kitty-send C-S-c)   ;; github session
  . (multi (on-press tap-vkey apps-us) (cmd rofimoji -a clipboard))
  caps caps
)

;; each binding focuses an already-open tab (via bruvtab) instead of opening a
;; duplicate; see scripts/open-url.sh.
(deflayermap (browser)
  ___ use-defsrc
  e (cmd zsh -lc "$HOME/github/dotfiles/scripts/open-url.sh https://mail.google.com/mail/u/0/#inbox")
  f (cmd zsh -lc "$HOME/github/dotfiles/scripts/open-url.sh https://www.perplexity.ai")
  g (cmd zsh -lc "$HOME/github/dotfiles/scripts/open-url.sh https://chatgpt.com")
  d (cmd zsh -lc "$HOME/github/dotfiles/scripts/open-url.sh https://claude.ai/new")
  r (cmd zsh -lc "$HOME/github/dotfiles/scripts/open-url.sh https://www.reverso.net/text-translation")
)

;; Only three typing-layer chords remain. Keep their tuned timings and
;; tap Esc/Enter + hold Ctrl+Shift behavior. Other chords are apps-only.
(defchordsv2
  (lsft rsft) @base-mode $reset-chord-time first-release ()
  (d f) (switch
    ((layer apps)) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell panel notifications") break
    () (tap-hold $tap-time $layer-time esc (multi lctl lsft)) break
  ) $chord-time all-released $not-base-or-apps
  (j k) (switch
    ((layer apps)) brdn break
    () (tap-hold $tap-time $layer-time ret (multi lctl lsft)) break
  ) $chord-time all-released $not-base-or-apps
  (s f) (multi lmet lsft) $chord-time all-released $not-base

  ;; Preserve the system map shown in the Quickshell overview.
  (w e) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell system") $chord-time all-released $not-apps
  (y u) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell panel audio") $chord-time all-released $not-apps
  (u i) vold $chord-time all-released $not-apps
  (i o) volu $chord-time all-released $not-apps
  (o p) mute $chord-time all-released $not-apps
  (h j) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell panel network") $chord-time all-released $not-apps
  (k l) brup $chord-time all-released $not-apps
  (l ;) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell panel bluetooth") $chord-time all-released $not-apps
  (e r) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell panel agents") $chord-time all-released $not-apps
  (r t) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell panel updates") $chord-time all-released $not-apps
  (x c) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell panel calendar") $chord-time all-released $not-apps
  (c v) (cmd zsh -lc "$HOME/.config/quickshell/dots-shell panel power") $chord-time all-released $not-apps
)

;; Plain typing: no HRMs, layer keys or letter chords. Both Shifts still
;; return to base; holding Enter also returns, while a tap sends Enter.
(deflayermap (normal)
  ___ use-defsrc
  ret (tap-hold $tap-time $mode-time ret @base-mode)
)
