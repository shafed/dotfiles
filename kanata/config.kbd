(defcfg
process-unmapped-keys (all-except lctl ralt) 
danger-enable-cmd yes
concurrent-tap-hold yes
)

(defvirtualkeys
  to-base (layer-switch base)
)

;; opposite-hand HRM (kanata PR #1955): hold only fires when the next key is on
;; the other hand, so fast same-hand rolls stay taps without manual key lists.
(defhands
  (left  q w e r t a s d f g z x c v b)
  (right y u i o p h j k l ; n m , . /)
)

(defvar
  tot 220  ;; tot=time out tap
  tap-time 200
  hold-time 200
  chord-time 60
  subl-time 200
  tmux-delay 20
  aterm-settle 250  ;; kitty-launch settle time before sending tmux keys
)

;; https://github.com/jtroo/kanata/discussions/1656
(deftemplate func (timeouttap timeouthold keytap keyhold)
	(tap-hold $timeouttap $timeouthold 
		(multi $keytap  @.tp) 
		$keyhold
	)
)

;; opposite-hand HRM: hold only when the next key is on the opposite hand
;; (per defhands). Same-hand keys tap immediately, replacing the old
;; per-key typing-list filtering.
(deftemplate hrm (timeout keytap keyhold)
  ;; -release variant: decides on the interrupting key's RELEASE, so fast
  ;; overlapping rolls/bigrams (the 2nd key lifts before the HRM key) resolve
  ;; to letters. Stacks with require-prior-idle below.
  (tap-hold-opposite-hand-release $timeout
    (multi $keytap @.tp)
    $keyhold
    ;; digits aren't in defhands; treat them as neutral->hold so e.g. Super+2
    ;; (workspace switch) fires from any HRM key, regardless of hand.
    (neutral-keys 1 2 3 4 5 6 7 8 9 0)
    (neutral hold)
    ;; same-hand key also activates the hold, so same-hand combos like
    ;; Ctrl+Shift (d+f) work. Trade-off: reintroduces same-hand roll misfire
    ;; risk during fast typing.
    (same-hand hold)
    ;; only treat as a mod if there was a >=150ms pause before this key.
    ;; during a fast typing stream the HRM stays a letter, killing cross-hand
    ;; bigram misfires like "sh" -> Super+h.
    (require-prior-idle 150)
  )
)

;; tmux-send focuses kitty, then sends the tmux prefix (C-s) followed by $key
(deftemplate tmux-send (key)
  (macro @aterm $aterm-settle C-s $tmux-delay $key)
)

(defalias
  ;; call @.tp whenever you want to enter fast typing-layer
  .tp (switch
        ;;(lsft rsft) XX break ;; optional skip typing-layer activation for upper case keys might solves some FJ problems
        ()  (multi
              (layer-switch typing)
              (on-idle 55 tap-vkey to-base) ;; timeouts from 30 to 100 are wide spread
            ) break
      )
  .spc-typing   (multi (layer-switch base) spc) ;; expilcitly leave typing-layer when hitting `space` - this allows experimenting with higher idle timeouts
  aterm (cmd zsh -lc "$HOME/.config/kanata/switchApp.sh kitty kitty")
  azen (cmd firefox)
  sshot (cmd flameshot gui --clipboard)
  sw (cmd hyprctl switchxkblayout kanata next)
  k-navi (fork up C-S-tab (lctl rctl))
  j-navi (fork down C-tab (lctl rctl))
  sw-lalt (switch ;; language switcher in normal layer
    ((input real lalt)) @sw break
    () lsft break
  )
)

(defsrc )

(deflayermap (base)
 ;; define home row mods (they act as typing-layer triggers, too )
 ;; AGCS layout: Alt-GUI-Ctrl-Shift (pinky->index), mirrored.
 a (t! hrm 300 a lalt)
 s (t! hrm 300 s lmet)
 d (t! hrm 300 d lctl)
 f (t! hrm 300 f lsft)
 j (t! hrm 300 j rsft)
 k (t! hrm 300 k rctl)
 l (t! hrm 300 l rmet)
 ; (t! hrm 300 ; ralt)

 ;; define functional keys
 lalt (t! func $tot 160 bspc (layer-while-held apps))
 ralt (t! func $tot 160 ret (layer-while-held apps))
 c (t! func $tap-time $hold-time c C-c)
 v (t! func $tap-time $hold-time v C-v)
 b (t! func $tap-time $hold-time b (macro @aterm 100 C-s $tmux-delay spc)) ;; tmux alternate session
 x (t! func $tap-time $hold-time x (cmd hyprctl dispatch cyclenext)) ;; focus last window in current workspace
 z (t! func $tap-time $hold-time z (cmd hyprctl dispatch workspace previous)) ;; focus last workspace

 ;; other
 caps (tap-hold $tap-time $hold-time esc (layer-toggle navi))
 bspc XX 
 ret (tap-hold $tap-time 600 XX (layer-switch normal)) ;; go to normal layer
;; lsft @sw
;; rsft rsft
 w (fork (multi w @.tp) bspc (lctl rctl))

 ;; define each letter as typing-layer trigger
 q (multi q @.tp) e (multi e @.tp) r (multi r @.tp) t (multi t @.tp) y (multi y @.tp) u (multi u @.tp) i (multi i @.tp) o (multi o @.tp) p (multi p @.tp) g (multi g @.tp) h (multi h @.tp) n (multi n @.tp) m (multi m @.tp)
)

(deflayermap (typing) 
 a a b b c c d d e e f f g g h h i i j j k k l l m m n n o o p p q q r r s s t t u u v v w w x x y y z z 
 lalt bspc ralt ret
 caps (tap-hold $tap-time $hold-time esc (layer-toggle navi))
)

(deflayermap (apps)
   
  f (t! tmux-send f)
  j (t! tmux-send s)
  q (cmd hyprctl dispatch killactive)
  e (t! tmux-send C-y)
  t (t! tmux-send C-t)
  r (t! tmux-send C-1)
  y (cmd firefox --new-window https://www.youtube.com/playlist?list=WL)
  u (cmd zsh -lc "$HOME/dotfiles/scripts/youtube-qat.sh") ;; yoUtube channel search QAT
  b (cmd zsh -lc "$HOME/dotfiles/scripts/bookmarks.sh") ;; Bookmarks fzf QAT
  a (cmd zsh -lc "$HOME/dotfiles/scripts/apps.sh") ;; Applications fzf QAT
  o (t! tmux-send C-o)
  w (t! tmux-send C-w)
  h (t! tmux-send C-a)
  s (tap-hold-press $subl-time $subl-time (cmd firefox) (layer-toggle browser))
  ;; a (layer-while-held terminal)
  ;; t (multi (cmd hyprctl dispatch workspace 5) (cmd telegram-desktop))
  d (t! tmux-send C-d)
  g (cmd todoist)
  z (cmd zsh -lc "$HOME/.config/kanata/switchApp.sh sioyek 'LIBGL_ALWAYS_SOFTWARE=1 sioyek'")
  p (t! tmux-send C-c)
  spc (cmd hyprlauncher)
  . (cmd rofimoji -a clipboard)
  caps caps
)

(deflayermap (browser)
  e (cmd firefox https://mail.google.com/mail/u/0/#inbox)
  d (cmd firefox  https://arena.ai)
  f (cmd firefox  https://www.perplexity.ai)
  g (cmd firefox  https://chatgpt.com)
  c (cmd firefox  https://claude.ai/new)
  r (cmd firefox https://www.reverso.net/text-translation)
)

(deflayermap (navi)
  ;; arrow keys
  h lft j @j-navi k @k-navi l right
  ;; words navigation
  w C-right b C-lft

  ;; mods
 f (t! func $tot 160 f lsft)
 d (t! func $tot 300 d lctl)
 s @sshot
 i C-S-i ;; kitty scrollback
)

(defchordsv2
(a s d f) @sshot $chord-time first-release()
(lalt lsft) @sw $chord-time first-release()
;; (a s) lsft $chord-time first-release()
;; (; l) rsft $chord-time first-release()
;; (d f) rsft $chord-time first-release()
;; (j k) rsft $chord-time first-release()
(lsft rsft) (layer-switch base) $chord-time first-release()
)

(deflayermap (normal)
  lsft @sw-lalt
  rsft rsft
  lalt lalt
  ralt ralt
  bspc bspc
  ret (tap-hold $tap-time 600 ret (layer-switch base)) 
  caps caps
)
