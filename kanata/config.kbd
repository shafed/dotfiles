(defcfg
  process-unmapped-keys (all-except lctl ralt)
  danger-enable-cmd yes
  concurrent-tap-hold yes
  chords-v2-min-idle 80
)

;; opposite-hand HRM (kanata PR #1955): hold only fires when the next key is on
;; the other hand, so fast same-hand rolls stay taps without manual key lists.
(defhands
  (left  grv tab q w e r t caps a s d f g z x c v b esc)
  (right - = bspc y u i o p [ ] \ h j k l ; ' n m , . /)
)

(defvar
  tot 220  ;; tap timeout
  tap-time 200
  hold-time 200
  chord-time 60
  mod-chord-time 35  ;; tight window for one-handed mod chords (d+f, j+k): both
                     ;; keys must land near-simultaneously, so sequential rolls
                     ;; like "fd" don't trigger Ctrl+Shift.
  subl-time 200
  aterm-settle 250  ;; kitty-focus settle before sending the session hotkey
)

(deftemplate th (timeouttap timeouthold keytap keyhold)
  (tap-hold $timeouttap $timeouthold
    $keytap
    $keyhold
  )
)

;; opposite-hand HRM: hold only when the next key is on the opposite hand.
;; -release variant decides on the interrupting key's RELEASE, so fast
;; overlapping rolls resolve to letters.
(deftemplate hrm (timeout keytap keyhold)
  (tap-hold-opposite-hand-release $timeout
    $keytap
    $keyhold
    ;; keys outside defhands that preserve HRM holds (Super+2, Ctrl+Space, ...)
    (neutral-keys 1 2 3 4 5 6 7 8 9 0 spc tab ret bspc esc)
    (neutral hold)
    ;; interrupting key HELD past the timeout forces the hold (e.g. j+v = C-S-v)
    (timeout hold)
  )
)

;; focuses kitty, then sends a kitty hotkey (kitty_mod = C-S-)
(deftemplate kitty-send (key)
  (multi (on-press tap-vkey apps-us) (macro @aterm $aterm-settle $key))
)

(defalias
  aterm (cmd zsh -lc "$HOME/.config/kanata/switchApp.sh kitty kitty")
  sshot-region (cmd hyprshot -m region --clipboard-only --silent)
  sshot-full (cmd hyprshot -m output --clipboard-only --silent)
  sw (cmd hyprctl switchxkblayout kanata next)
  k-navi (fork up C-S-tab (lalt ralt))
  j-navi (fork down C-tab (lalt ralt))
  sw-lalt (switch ;; language switcher in normal layer
    ((input real lalt)) @sw break
    () lsft break
  )
  ;; symbol-layer entry wrapped with the xkb US switch (same symbols on RU/US)
  sym-enter (multi (on-press tap-vkey sym-us) (on-release tap-vkey sym-restore) (layer-while-held symbols))
  sym-enter2 (multi (on-press tap-vkey sym-us) (on-release tap-vkey sym-restore) (layer-while-held symbols2))
  apps-enter (layer-while-held apps)
)

(defvirtualkeys
  sym-us (cmd /home/shafed/dotfiles/scripts/symlayout-watch.sh enter)
  sym-restore (cmd /home/shafed/dotfiles/scripts/symlayout-watch.sh leave)
  apps-us (cmd /home/shafed/dotfiles/scripts/symlayout-watch.sh app)
)

(defsrc)

(deflayermap (base)
  ;; home row mods (opposite-hand), AGCS: Alt-GUI-Ctrl-Shift (pinky->index), mirrored.
  a (t! hrm 400 a lalt)
  s (t! hrm 400 s lmet)
  d (t! hrm 400 d lctl)
  f (t! hrm 300 f lsft)
  j (t! hrm 300 j rsft)
  k (t! hrm 400 k rctl)
  l (t! hrm 400 l rmet)
  ; (t! hrm 400 ; ralt)

  ;; functional keys
  lalt (t! th $tot 160 bspc @apps-enter) ;; tap=bspc hold=apps
  ralt (t! th $tot 160 @sw @apps-enter)  ;; tap=switch lang hold=apps
  c (t! th $tap-time $hold-time c C-c)
  v (t! th $tap-time $hold-time v C-v)
  b (t! th $tap-time $hold-time b (macro @aterm 100 A-tab)) ;; kitty last session (goto_session -1)
  x (t! th $tap-time $hold-time x (cmd hyprctl dispatch "hl.dsp.window.cycle_next()")) ;; focus last window
  z (t! th $tap-time $hold-time z (cmd hyprctl dispatch r#"hl.dsp.focus({ workspace = "previous" })"#)) ;; focus last workspace
  m (t! th $tot 160 m (layer-while-held numws))  ;; tap-hold: switch workspace
  n (t! th $tot 160 n (layer-while-held movews))  ;; tap-hold: switch workspace

  caps (t! th $tap-time $hold-time XX (layer-toggle navi))
  bspc XX
  ret (tap-hold $tap-time 600 XX (multi (layer-switch normal) (cmd notify-send -t 1000 "⌨ normal layer"))) ;; go to normal layer
  w (fork (t! th $tot 160 w (layer-while-held navi)) bspc (lctl rctl)) ;; tap=w hold=navi; Ctrl+w -> bspc
)

(deflayermap (apps)
  e (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/dotfiles/kitty/scripts/kitty-zoxide-session.sh")) ;; zoxide session picker QAT
  l (layer-while-held numws)  ;; hold: switch workspace (Super+digit)
  q (cmd hyprctl dispatch "hl.dsp.window.close()") ;; graceful close -> apps with tray icons minimize instead of quitting
  t (t! kitty-send C-S-2)   ;; todos session
  r (t! kitty-send C-S-1)   ;; daily note
  y (cmd helium-browser --new-window https://www.youtube.com/playlist?list=WL)
  u (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/dotfiles/scripts/youtube-qat.sh")) ;; youtube channel search QAT
  b (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/dotfiles/scripts/bookmarks.sh")) ;; bookmarks fzf QAT
  f (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/dotfiles/scripts/search.sh")) ;; web search fzf QAT
  a (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/dotfiles/scripts/apps.sh")) ;; applications fzf QAT
  o (t! kitty-send C-S-o)   ;; obsidian session
  w (t! kitty-send C-S-w)   ;; downloads session
  h (t! kitty-send C-S-a)   ;; home session
  s (tap-hold-press $subl-time $subl-time (cmd helium-browser) (layer-toggle browser))
  d (t! kitty-send C-S-d)   ;; dotfiles session
  z (cmd zsh -lc "$HOME/.config/kanata/switchApp.sh sioyek 'sioyek'")
  c (multi (on-press tap-vkey apps-us) (cmd zsh -lc "$HOME/dotfiles/kitty/scripts/kitty-list-sessions.sh")) ;; list sessions picker QAT
  g (t! kitty-send C-S-c)   ;; github session
  . (multi (on-press tap-vkey apps-us) (cmd rofimoji -a clipboard))
  caps caps
)

(deflayermap (browser)
  e (cmd helium-browser https://mail.google.com/mail/u/0/#inbox)
  f (cmd helium-browser https://www.perplexity.ai)
  g (cmd helium-browser https://chatgpt.com)
  d (cmd helium-browser https://claude.ai/new)
  r (cmd helium-browser https://www.reverso.net/text-translation)
)

;; right-hand symbols, momentary (s+d held). S-... keycodes output the same
;; symbols on US and RU (kanata switches to US while held).
(deflayermap (symbols)
  y grv u [   i ]   o S-=   p XX       ;; ` [ ] +
  h - j S-9 k S-0 l S-2 ; S-;   ' S-'  ;; - ( ) @ : "
  n S-- m = , S-, . S-.   / S-/      ;; _ = < > ?
)

;; second symbol set, momentary (s+d+f held); longer chord beats (s d).
(deflayermap (symbols2)
  y S-grv u S-[ i S-] o S-7  p XX      ;; ~ { } &
  h S-1 j S-3 k S-8 l S-\  ; ; ' ' ;; ! # * |
  n \ m S-5  , S-6 . S-4 / /          ;; \ % ^ $
)

;; workspace numbers, momentary (apps+l held): Super+digit.
(deflayermap (numws)
  q M-6 w M-7 e M-8 r M-9 t M-0   ;; Super+6..0  (workspaces 6-10)
  a M-1 s M-2 d M-3 f M-4 g M-5   ;; Super+1..5  (workspaces 1-5)
)

;; move window to workspace, momentary (j+l chord): Super+Shift+digit.
(deflayermap (movews)
  q M-S-6 w M-S-7 e M-S-8 r M-S-9 t M-S-0   ;; Super+Shift+6..0  (workspaces 6-10)
  a M-S-1 s M-S-2 d M-S-3 f M-S-4 g M-S-5   ;; Super+Shift+1..5  (workspaces 1-5)
)

;; plain digits on the left hand
(deflayermap (numplain)
  q 6 w 7 e 8 r 9 t 0
  a 1 s 2 d 3 f 4 g 5
  z S-= x = c - v S--
  n S-- h -
)

;; shifted digits, same positions as numplain
(deflayermap (numplain2)
  q S-6 w S-7 e S-8 r S-9 t S-0
  a S-1 s S-2 d S-3 f S-4 g S-5
)

;; entered via hold w (left hand). all motions live on the right hand so the
;; left stays on the w hold.
(deflayermap (navi)
  ;; arrow keys
  h lft j @j-navi k @k-navi l right
  ;; word navigation: n=C-left . =C-right
  n C-lft m C-right
  ;; browser tabs: y=prev u=next; home/end on i/o
  u C-S-tab i C-tab
  o home p end
  ;; browser history: [ back ] fwd; ;=close '=reopen
  [ A-lft ] A-right
  ; C-w ' C-S-t

  ;; mods (left hand, free while w is held)
  f (t! th $tot 160 f lsft)
  d (t! th $tot 300 d lctl)
  s (t! th $tap-time $hold-time @sshot-full @sshot-region) ;; tap=full screen->clipboard, hold=region->clipboard
)

(defchordsv2
  ;; one-handed Ctrl+Shift (d+f, j+k): press both together after a >=80ms idle
  ;; (chords-v2-min-idle) for a held Ctrl+Shift; all-released keeps the mods
  ;; down until both keys lift, so you can add a third key (e.g. C-S-tab).
  (lsft rsft) (multi (layer-switch base) (cmd notify-send -t 1000 "⌨ base layer")) $chord-time first-release ()
  (d f) (tap-hold $tap-time $hold-time esc (multi lctl lsft)) $mod-chord-time all-released () ;; tap=esc hold=C-S
  (j k) (tap-hold $tap-time $hold-time ret (multi lctl lsft)) $mod-chord-time all-released () ;; enter
  (s f) (multi lmet lsft) $mod-chord-time all-released () ;; Super+Shift
  (k l) (layer-while-held numplain) $mod-chord-time all-released () ;; number layer
  (j k l) (layer-while-held numplain2) $mod-chord-time all-released () ;; shifted numbers
  (s d) @sym-enter $mod-chord-time all-released () ;; symbol layer
  (s d f) @sym-enter2 $mod-chord-time all-released () ;; symbol layer 2
  (j l) (layer-while-held movews) $mod-chord-time all-released () ;; move window to workspace
  (w e) tab $mod-chord-time all-released () ;; tab
)

(deflayermap (normal)
  lsft @sw-lalt
  rsft rsft
  lalt lalt
  ralt ralt
  bspc bspc
  ret (tap-hold $tap-time 600 ret (multi (layer-switch base) (cmd notify-send -t 1000 "⌨ base layer")))
  caps caps
)
