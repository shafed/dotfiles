(defcfg
process-unmapped-keys (all-except lctl ralt)
danger-enable-cmd yes
concurrent-tap-hold yes
chords-v2-min-idle 80   ;; after any non-chord keypress, skip chords for 80ms
                        ;; so one-handed mod chords (d+f, j+k) fire near-instantly
                        ;; after a brief pause, but not mid fast typing.
)

;; opposite-hand HRM (kanata PR #1955): hold only fires when the next key is on
;; the other hand, so fast same-hand rolls stay taps without manual key lists.
(defhands
  (left  grv tab q w e r t caps a s d f g z x c v b esc)
  (right - = bspc y u i o p [ ] \ h j k l ; ' n m , . /)
)

(defvar
  tot 220  ;; tot=time out tap
  tap-time 200
  hold-time 200
  chord-time 60
  mod-chord-time 35  ;; tight window for one-handed mod chords (d+f, j+k): both
                     ;; keys must land near-simultaneously, so sequential rolls
                     ;; like "fd" don't trigger Ctrl+Shift.
  subl-time 200
  aterm-settle 250  ;; kitty-focus settle time before sending the session hotkey
)

(deftemplate th (timeouttap timeouthold keytap keyhold)
	(tap-hold $timeouttap $timeouthold
		$keytap
		$keyhold
	)
)

;; opposite-hand HRM: hold only when the next key is on the opposite hand
;; (per defhands). Same-hand keys tap immediately. defhands + the -release
;; variant below replace the old typing-layer misfire guard entirely.
(deftemplate hrm (timeout keytap keyhold)
  ;; -release variant: decides on the interrupting key's RELEASE, so fast
  ;; overlapping rolls/bigrams (the 2nd key lifts before the HRM key) resolve
  ;; to letters. This alone kills cross-hand misfires like "sh" -> Super+h.
  (tap-hold-opposite-hand-release $timeout
    $keytap
    $keyhold
    ;; digits aren't in defhands; treat them as neutral->hold so e.g. Super+2
    ;; (workspace switch) fires from any HRM key, regardless of hand.
    (neutral-keys 1 2 3 4 5 6 7 8 9 0)
    (neutral hold)
    ;; same-hand stays at the default 'tap': same-hand bigrams (fd, as, sd...)
    ;; resolve to letters, killing rolls like fd -> D. Trade-off: one-handed
    ;; mod combos (e.g. d+f = Ctrl+Shift on the left hand alone) no longer work;
    ;; take Ctrl/Shift combos across hands instead.
    ;; when the interrupting key is HELD past the timeout (not released, so the
    ;; -release rule never fires), force the hold. lets you hold j(Shift) and
    ;; hold v(C-v) to get C-S-v, etc.
    (timeout hold)
  )
)

;; kitty-send focuses kitty, then sends a kitty hotkey (kitty_mod = C-S-)
;; that drives native sessions. Replaces the old tmux prefix (C-s) scheme.
(deftemplate kitty-send (key)
  (macro @aterm $aterm-settle $key)
)

(defalias
  aterm (cmd zsh -lc "$HOME/.config/kanata/switchApp.sh kitty kitty")
  azen (cmd firefox)
  sshot (cmd flameshot gui --clipboard)
  sw (cmd hyprctl switchxkblayout kanata next)
  k-navi (fork up C-S-tab (lalt ralt))
  j-navi (fork down C-tab (lalt ralt))
  sw-lalt (switch ;; language switcher in normal layer
    ((input real lalt)) @sw break
    () lsft break
  )
)

(defsrc )

(deflayermap (base)
 ;; define home row mods (opposite-hand)
 ;; AGCS layout: Alt-GUI-Ctrl-Shift (pinky->index), mirrored.
 a (t! hrm 400 a lalt)
 s (t! hrm 400 s lmet)
 d (t! hrm 400 d lctl)
 f (t! hrm 300 f lsft)
 j (t! hrm 300 j rsft)
 k (t! hrm 400 k rctl)
 l (t! hrm 400 l rmet)
 ; (t! hrm 400 ; ralt)

 ;; define functional keys
 lalt (t! th $tot 160 bspc (layer-while-held apps)) ;; tap=bspc hold=apps
 ralt (t! th $tot 160 @sw (layer-while-held apps))  ;; tap=switch lang hold=apps
 c (t! th $tap-time $hold-time c C-c)
 v (t! th $tap-time $hold-time v C-v)
 b (t! th $tap-time $hold-time b (macro @aterm 100 A-tab)) ;; kitty last session (goto_session -1)
 x (t! th $tap-time $hold-time x (cmd hyprctl dispatch cyclenext)) ;; focus last window in current workspace
 z (t! th $tap-time $hold-time z (cmd hyprctl dispatch workspace previous)) ;; focus last workspace

 ;; other
 caps (t! th $tap-time $hold-time XX (layer-toggle navi)) ;; test esc on df
 bspc XX 
 ret (tap-hold $tap-time 600 XX (multi (layer-switch normal) (cmd notify-send -t 1000 "⌨ normal layer"))) ;; go to normal layer
 ;; lsft @sw ;; physical LShift taps to switch keyboard layout
 w (fork w bspc (lctl rctl))
)

(deflayermap (apps)
   
  f (t! kitty-send C-S-f)   ;; zoxide session picker
  j (t! kitty-send C-S-s)   ;; list sessions picker
  q (cmd hyprctl dispatch killactive)
  t (t! kitty-send C-S-2)   ;; todos session
  r (t! kitty-send C-S-1)   ;; daily note
  y (cmd firefox --new-window https://www.youtube.com/playlist?list=WL)
  u (cmd zsh -lc "$HOME/dotfiles/scripts/youtube-qat.sh") ;; yoUtube channel search QAT
  b (cmd zsh -lc "$HOME/dotfiles/scripts/bookmarks.sh") ;; Bookmarks fzf QAT
  a (cmd zsh -lc "$HOME/dotfiles/scripts/apps.sh") ;; Applications fzf QAT
  o (t! kitty-send C-S-o)   ;; obsidian session
  w (t! kitty-send C-S-w)   ;; downloads session
  h (t! kitty-send C-S-a)   ;; home session
  s (tap-hold-press $subl-time $subl-time (cmd firefox) (layer-toggle browser))
  ;; a (layer-while-held terminal)
  ;; t (multi (cmd hyprctl dispatch workspace 5) (cmd telegram-desktop))
  d (t! kitty-send C-S-d)   ;; dotfiles session
  g (cmd todoist)
  z (cmd zsh -lc "$HOME/.config/kanata/switchApp.sh sioyek 'LIBGL_ALWAYS_SOFTWARE=1 sioyek'")
  p (t! kitty-send C-S-c)   ;; projects session
  . (cmd rofimoji -a clipboard)
  caps caps
)

(deflayermap (browser)
  e (cmd firefox https://mail.google.com/mail/u/0/#inbox)
  f (cmd firefox  https://www.perplexity.ai)
  g (cmd firefox  https://chatgpt.com)
  d (cmd firefox  https://claude.ai/new)
  r (cmd firefox https://www.reverso.net/text-translation)
)

;; right-hand programmer symbols, momentary (entered via s+d+f chord held).
;; left hand holds s/d/f, so all symbols live on the right hand.
(deflayermap (symbols)
  y S-1 u S-2 i S-3 o S-4 p S-5   ;; ! @ # $ %
  h S--  j S-9 k S-0 l =   ; -    ;; _ ( ) = -   (home row: most-used)
  n S-6 m S-7 , S-8 . S-=  / S-\   ;; ^ & * + |
)

;; left-hand number layers, momentary. entered via chords: (k l) -> numws
;; (Super+N, Hyprland workspaces); (k l ;) -> numtab (Alt+N, Firefox tabs).
;; digits on the left hand, mod baked into each key. l/; stay plain rmet/ralt.
;; layout mirrors symbols: home row = 1-5, top row = 6-0.
(deflayermap (numws)
  q M-6 w M-7 e M-8 r M-9 t M-0   ;; Super+6..0  (workspaces 6-10)
  a M-1 s M-2 d M-3 f M-4 g M-5   ;; Super+1..5  (workspaces 1-5)
)

(deflayermap (numtab)
  q A-6 w A-7 e A-8 r A-9 t A-0   ;; Alt+6..0  (Firefox tabs; A-9 = last tab)
  a A-1 s A-2 d A-3 f A-4 g A-5   ;; Alt+1..5
)

;; plain digits on the left hand, momentary (entered via j+k+l held).
(deflayermap (numplain)
  q 6 w 7 e 8 r 9 t 0
  a 1 s 2 d 3 f 4 g 5
)

(deflayermap (navi)
  ;; arrow keys
  h lft j @j-navi k @k-navi l right
  ;; words navigation
  w C-right b C-lft

  ;; mods
 f (t! th $tot 160 f lsft)
 d (t! th $tot 300 d lctl)
 s @sshot
 i (t! kitty-send C-S-i) ;; kitty scrollback -> full pane history in nvim
)

(defchordsv2
;; one-handed Ctrl+Shift: press both keys together (after a >=150ms idle, per
;; chords-v2-min-idle) to get a held Ctrl+Shift. all-released keeps the mods
;; down until both keys lift, so you can add a third key (e.g. C-S-tab).
(lsft rsft) (multi (layer-switch base) (cmd notify-send -t 1000 "⌨ base layer")) $chord-time first-release()
(d f) (tap-hold $tap-time $hold-time esc (multi lctl lsft)) $mod-chord-time all-released () ;; tap=esc hold=C-S
(j k) (tap-hold $tap-time $hold-time ret (multi lctl lsft)) $mod-chord-time all-released () ;; enter 
(s f) (multi lmet lsft) $mod-chord-time all-released ()
(l j) (multi rmet rsft) $mod-chord-time all-released ()
(s d f) (layer-while-held symbols) $mod-chord-time all-released () ;; symbol layer
(j k l) (layer-while-held numplain) $mod-chord-time all-released () ;; number layer
(k l) (layer-while-held numws) $mod-chord-time all-released ()    ;; Super+digit workspace
(l ;) (layer-while-held numtab) $mod-chord-time all-released () ;; Alt+digit firefox tabs
(s d) tab $mod-chord-time all-released () ;; tab
(w e r) C-bspc $mod-chord-time all-released () ;; delete word (works everywhere)
)

(deflayermap (normal)
  lsft @sw-lalt
  rsft rsft
  lalt lalt
  ralt ralt
  bspc bspc
  ret (tap-hold $tap-time 600 ret (multi (layer-switch base) (cmd notify-send -t 1000 "⌨ base layer")))
  caps caps
)
