#!/usr/bin/env bash
set -euo pipefail

# start.sh launches `quickshell -p "$root"` where $root is this file's own
# directory (the tracked QML tree runs directly — no more prepare.py runtime
# copy under ~/.cache/dots-shell/quickshell, see "quickshell: run tracked qml
# tree directly"). IPC has to target that same path or every call here fails
# with "No running instances" even though quickshell is up. Self-locating
# keeps this correct regardless of which checkout ~/.config/quickshell points
# at (main or an isolated worktree), same as start.sh's own $root. `quickshell
# ipc -p` matches the literal resolved shell.qml path, not just wherever it
# leads, so this must follow readlink -f itself rather than only `cd` into the
# symlinked ~/.config/quickshell dir (which keeps the symlink name in $PWD) —
# otherwise IPC calls made through the ~/.config/quickshell symlink miss the
# instance started via start.sh's own (already-real) path.
script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
config="${QUICKSHELL_CONFIG_DIR:-$script_dir}"

ipc() {
  quickshell ipc -p "$config" call "$@"
}

close_hotkeys() {
  ipc hotkeys close >/dev/null 2>&1 || true
}

close_pickers() {
  ipc launcher close >/dev/null 2>&1 || true
  ipc bookmarks close >/dev/null 2>&1 || true
  ipc quickpicker close >/dev/null 2>&1 || true
  ipc youtube close >/dev/null 2>&1 || true
  ipc scratch close >/dev/null 2>&1 || true
}

case "${1:-}" in
  launcher|apps)
    close_hotkeys
    ipc dots closeOverlays >/dev/null 2>&1 || true
    ipc bookmarks close >/dev/null 2>&1 || true
    ipc quickpicker close >/dev/null 2>&1 || true
    ipc youtube close >/dev/null 2>&1 || true
    ipc scratch close >/dev/null 2>&1 || true
    ipc launcher toggle
    ;;
  bookmarks)
    close_hotkeys
    ipc dots closeOverlays >/dev/null 2>&1 || true
    ipc launcher close >/dev/null 2>&1 || true
    ipc quickpicker close >/dev/null 2>&1 || true
    ipc youtube close >/dev/null 2>&1 || true
    ipc scratch close >/dev/null 2>&1 || true
    ipc bookmarks toggle
    ;;
  clipboard)
    # CopyQ's own window, not a Quickshell overlay — it has its own history,
    # search and paste handling, so there's nothing left for Quickshell to
    # own here beyond closing whatever picker is currently open first.
    # If the nvim QAT scratch is visible, hide (do not close) it before CopyQ
    # opens so the scratch layer's blur/dim does not affect the clipboard UI;
    # the draft stays alive and Super+N restores it afterwards.
    # QT_QPA_PLATFORM=xcb matches the copyq shell alias (zsh/zshrc): the
    # client process that renders the toggled window needs it even though
    # copyq.service's headless server does not.
    close_hotkeys
    close_pickers
    "$script_dir/../scripts/nvim-scratch-toggle.sh" --hide >/dev/null 2>&1 || true
    QT_QPA_PLATFORM=xcb copyq toggle >/dev/null 2>&1
    ;;
  projects|sessions)
    close_hotkeys
    ipc dots closeOverlays >/dev/null 2>&1 || true
    ipc launcher close >/dev/null 2>&1 || true
    ipc bookmarks close >/dev/null 2>&1 || true
    ipc youtube close >/dev/null 2>&1 || true
    ipc scratch close >/dev/null 2>&1 || true
    ipc quickpicker toggle "$1"
    ;;
  youtube)
    close_hotkeys
    ipc dots closeOverlays >/dev/null 2>&1 || true
    ipc launcher close >/dev/null 2>&1 || true
    ipc bookmarks close >/dev/null 2>&1 || true
    ipc quickpicker close >/dev/null 2>&1 || true
    ipc scratch close >/dev/null 2>&1 || true
    ipc youtube toggle
    ;;
  scratch)
    target="none"
    if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
      target="$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // "none"' 2>/dev/null || printf none)"
      [[ -n "$target" && "$target" != "null" ]] || target="none"
    fi
    close_hotkeys
    ipc dots closeOverlays >/dev/null 2>&1 || true
    ipc launcher close >/dev/null 2>&1 || true
    ipc bookmarks close >/dev/null 2>&1 || true
    ipc quickpicker close >/dev/null 2>&1 || true
    ipc youtube close >/dev/null 2>&1 || true
    ipc scratch toggle "$target"
    ;;
  hotkeys)
    ipc dots closeOverlays >/dev/null 2>&1 || true
    close_pickers
    ipc hotkeys toggle
    ;;
  system)
    close_hotkeys
    close_pickers
    ipc dots panel system
    ;;
  panel)
    [[ $# -ge 2 ]] || {
      echo "usage: dots-shell panel <system|audio|network|bluetooth|power|agents|updates|notifications|calendar>" >&2
      exit 2
    }
    close_hotkeys
    close_pickers
    ipc dots panel "$2"
    ;;
  refresh)
    ipc dots refresh
    ;;
  osd)
    [[ $# -ge 4 ]] || { echo "usage: dots-shell osd <icon> <label> <value>" >&2; exit 2; }
    ipc dots showOsd "$2" "$3" "$4"
    ;;
  *)
    ipc dots "$@"
    ;;
esac
