[Unit]
Description=Keyboard layout OSD watcher
PartOf=graphical-session.target
After=graphical-session.target quickshell.service

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %h/github/dotfiles/quickshell/layout-watch.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
