[Unit]
Description=Personal Quickshell desktop shell
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=%h/github/dotfiles/quickshell/shell.qml

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 %h/github/dotfiles/quickshell/prepare.py
ExecStart=/usr/bin/env quickshell -p %h/.cache/dots-shell/quickshell
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
