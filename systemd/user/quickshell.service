[Unit]
Description=Personal Quickshell desktop shell
PartOf=graphical-session.target
Wants=layout-osd.service brightness-osd.service audio-osd.service
After=graphical-session.target
ConditionPathExists=%h/github/dotfiles/quickshell/shell.qml

[Service]
Type=simple
ExecStart=/usr/bin/env bash %h/github/dotfiles/quickshell/start.sh
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
