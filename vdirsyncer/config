[general]
status_path = "~/.local/state/vdirsyncer/status/"

[pair google_calendar]
a = "google_calendar_local"
b = "google_calendar_remote"
collections = ["from b"]
metadata = ["color", "displayname"]

[storage google_calendar_local]
type = "filesystem"
path = "~/.local/share/calendars/google/"
fileext = ".ics"

[storage google_calendar_remote]
type = "google_calendar"
token_file = "~/.local/state/vdirsyncer/google-token"
client_id.fetch = ["shell", "sed -n 's/^client_id=//p' \"${XDG_CONFIG_HOME:-$HOME/.config}/vdirsyncer/google-credentials\" | head -n1"]
client_secret.fetch = ["shell", "sed -n 's/^client_secret=//p' \"${XDG_CONFIG_HOME:-$HOME/.config}/vdirsyncer/google-credentials\" | head -n1"]
