# Gruvbox Material Dark Medium for Oh My Zsh.
# Keeps robbyrussell's prompt shape, only changes colors.

PROMPT='%F{#e78a4e}➜ %F{#7daea3}%c%f $(git_prompt_info)'

ZSH_THEME_GIT_PROMPT_PREFIX="%F{#928374}git:(%F{#d8a657}"
ZSH_THEME_GIT_PROMPT_SUFFIX="%F{#928374})%f "
ZSH_THEME_GIT_PROMPT_DIRTY="%F{#e78a4e}✗%f"
ZSH_THEME_GIT_PROMPT_CLEAN="%F{#a9b665}✓%f"
