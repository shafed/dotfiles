# Kitty companion-pane toggle (mirrors nvim's <M-t>), see wiki/zsh.md.
export KITTY_WINDOW_DIRECTION="right"

function kitty_other_window() {
  local move=left
  [[ $KITTY_WINDOW_DIRECTION == "right" ]] || move=up
  kitten @ action neighboring_window "$move"
  kitten @ action goto_layout stack
}
zvm_define_widget kitty_other_window

# after_init, not after_lazy_keybindings (the latter never fires with lazy off; wiki/zsh.md).
function zvm_after_init() {
  zvm_bindkey vicmd '^[t' kitty_other_window
  zvm_bindkey viins '^[t' kitty_other_window
}

